# Copy to .env.local before running pnpm dev

# Supabase (Vercel Marketplace auto-provisions these in production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY  # only for server-side admin ops

# Direct Anthropic (preferred — no Vercel AI Gateway credit-card prompt)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Override the direct model id (defaults to claude-sonnet-4-5)
# LLAVE_MODEL_ID=claude-sonnet-4-5

# Vercel AI Gateway (alternative — requires a credit card on the team)
# AI_GATEWAY_API_KEY=vck_xxxxxxxxxxxxxxxxxxxx
# LLAVE_GATEWAY_MODEL_ID=anthropic/claude-sonnet-4-5

# Force the offline mock model regardless of keys (offline demo)
# LLAVE_OFFLINE=1
