# Copy to .env.local before running pnpm dev

# Supabase (Vercel Marketplace auto-provisions these in production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY  # only for server-side admin ops

# Vercel AI Gateway (preferred — single token, multi-provider)
AI_GATEWAY_API_KEY=vck_xxxxxxxxxxxxxxxxxxxx

# Direct Anthropic (fallback if not using AI Gateway)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
